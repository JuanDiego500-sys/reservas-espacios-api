{
    "name": "reservas-espacios-api",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "start": "node ./dist/server/entry.mjs",
        "test": "vitest run",
        "db": "docker compose up -d",
        "db:cargar": "docker compose exec -T db psql -U reservas -d reservas -v ON_ERROR_STOP=1 <db/schema.sql && docker compose exec -T db psql -U reservas -d reservas -v ON_ERROR_STOP=1 <db/datos.sql"
    },
    "dependencies": {
        "@astrojs/node": "^11.1.9",
        "astro": "^7.4.5"
    },
    "devDependencies": {
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    }
}
